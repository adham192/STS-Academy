# Cloud Hosted
api-key="Your-Gemini-API-Key"
model="gemini-3.5-flash"

# Locally Hosted
OLLAMA_HOST="Your-Local-OLLAMA-Host"
LOCAL_MODEL="Your-Local-Model"

# Open Router Key
OPENROUTER_API_KEY="Your-Open-Router-API-Key"
OPENROUTER_MODEL=openai/text-embedding-3-small


# POSTGRESQL
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=Your-PostgreSQL-Password
POSTGRES_DB=chatbot
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://chatbot:Your-PostgreSQL-Password@localhost:5433/chatbot

#REDIS
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Docker Compose only (used inside the containers)
DOCKER_DATABASE_URL=postgresql+psycopg://chatbot:Your-PostgreSQL-Password@postgres:5432/chatbot
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_OLLAMA_HOST=http://host.docker.internal:Your-OLLAMA-Port