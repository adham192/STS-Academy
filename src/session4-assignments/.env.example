# Cloud Hosted
api-key="Your-Gemini-API-Key"
model="gemini-3.5-flash"

# Locally Hosted
OLLAMA_HOST="LOCALHOST"
LOCAL_MODEL="OLLAMA_MODEL_NAME"

# Open Router Key
OPENROUTER_API_KEY= "OPENROUTER_API_KEY"
OPENROUTER_MODEL=openai/text-embedding-3-small

# POSTGRESQL
POSTGRES_USER=YourPostgresUser
POSTGRES_PASSWORD=YourPostgresPassword
POSTGRES_DB=YourPostgresDB
POSTGRES_PORT=YourPostgresPort #5432 is the default port for PostgreSQL

DATABASE_URL=postgresql+psycopg://YourPostgresUser:YourPostgresPassword@localhost:YourPostgresPort/chatbot