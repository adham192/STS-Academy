# Cloud Hosted
api-key="Your-Gemini-API-Key"
model="gemini-3.5-flash"

# Locally Hosted
OLLAMA_HOST="LOCALHOST"
LOCAL_MODEL="OLLAMA_MODEL_NAME"

# Open Router Key
OPENROUTER_API_KEY= "OPENROUTER_API_KEY"
OPENROUTER_MODEL=openai/text-embedding-3-small

# POSTGRESQL
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=MyLocalPassword123
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://chatbot:MyLocalPassword123@localhost:5432/chatbot